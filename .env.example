# Required deployment secrets. Generate independent random 32-byte hex values.
# Never use example/default values in production; preserve ENCRYPTION_KEY on upgrades.
ENCRYPTION_KEY=
ADMIN_TOKEN=
# Optional GitHub and email settings are documented in docs/integrations/.
# Keep live secrets in ignored .dev.vars or a secret store, never this file.

# Optional webhooks: separately provision the Node gateway (docs/egress.md).
# EGRESS_PROXY_URL=https://egress.your-domain.tld/deliver
# EGRESS_PROXY_TOKEN=<independent random 32-byte hex secret>

# Operator circuit breakers (default enabled; literal false pauses the operation).
# SIGNUPS_ENABLED=false
# VERIFICATIONS_ENABLED=false
# DELIVERY_ENABLED=false
